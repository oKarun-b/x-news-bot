# x-news-bot — copy to .env and fill in real values
# Never commit .env

# ── Secrets (required for production) ──────────────
OPENROUTER_API_KEY=
BUFFER_ACCESS_TOKEN=
BUFFER_CHANNEL_ID=
# BUFFER_ORGANIZATION_ID is auto-discovered; set only to pin it
# BUFFER_ORGANIZATION_ID=

# ── Identity / mode ─────────────────────────────────
BOT_TIMEZONE=UTC
BOT_ENABLED=true
DRY_RUN=false
LOG_LEVEL=INFO

# ── Monitoring windows (BOT_TIMEZONE) ───────────────
ACTIVE_MONITORING_START=06:00
ACTIVE_MONITORING_END=23:30
OVERNIGHT_COLLECTION=true
ALLOW_BREAKING_OUTSIDE_WINDOW=true

# ── Posting window (scheduling bounds, BOT_TIMEZONE)
POSTING_START_HOUR=7
POSTING_END_HOUR=22

# ── Limits ──────────────────────────────────────────
MAX_TOTAL_POSTS_PER_DAY=10
MAX_AI_POSTS_PER_DAY=8
RESERVED_FIXED_POSTS=2
MAX_BUFFER_AHEAD_POSTS=3
MAX_SCHEDULE_HORIZON_MINUTES=180
MAX_NEW_POSTS_PER_RUN=2
MAX_AI_CALLS_PER_RUN=3
TOP_CANDIDATES_PER_RUN=6

# ── Gaps ────────────────────────────────────────────
MIN_NORMAL_GAP_MINUTES=25
MAX_NORMAL_GAP_MINUTES=180
BREAKING_MIN_DELAY_MINUTES=2

# ── Breaking / priority ─────────────────────────────
BREAKING_MAX_AGE_MINUTES=180
BREAKING_PRIORITY=100
URGENT_PRIORITY=90
HIGH_PRIORITY=75
NORMAL_PRIORITY=50
LOW_PRIORITY=25
MIN_DEVELOPMENT_GAP_MINUTES=90

# ── Content / AI ────────────────────────────────────
MAX_POST_LENGTH=260
HARD_MAX_POST_LENGTH=280
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_FALLBACK_MODELS=minimax/minimax-m2.7:free,liquid/lfm-2.5-2.6b:free,google/gemma-4-26b-a4b-it:free
CLUSTER_SIMILARITY_THRESHOLD=0.45
STATE_RETENTION_DAYS=7
ARTICLE_RETENTION_DAYS=3
FEED_TIMEOUT_SECONDS=10
ARTICLE_FETCH_MAX=2
ENABLE_QUEUE_RESHUFFLE=false

# ── Buffer ──────────────────────────────────────────
BUFFER_API_URL=https://api.buffer.com
